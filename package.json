{
  "name": "pi-repository-references",
  "version": "0.1.0",
  "private": true,
  "description": "A Pi extension for consulting source code from Git repositories outside the active project.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "CONTEXT.md",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --exclude=test/integration/**",
    "test:integration": "vitest run test/integration/pi-repository-references.integration.test.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run format && npm run lint"
  },
  "pi": {
    "extensions": [
      "./extensions/repository-references.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typebox": "^1.3.16",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
